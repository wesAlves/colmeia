  {"model": "journal.visit", "pk": 1, "fields": {"house": 1, "visited_at": "2025-06-10T14:30:00Z", "attendees": "Wes, Bru", "overall_impression": "Warm and bright. Loved the double living room.", "experience": "The agent was on time. The flat smells of fresh paint and the afternoon light in the living room is gorgeous. Kitchen is small but recently refurbished. The two small bedrooms face the street so there is some traffic noise when the window is open.", "considerations": "Ask about the condominium fees. Check if the parking spot is included or rented separately. Second visit should be at night to gauge noise.", "created_by": 1, "created_at": "2025-06-10T18:00:00Z"}},
  {"model": "journal.visit", "pk": 2, "fields": {"house": 1, "visited_at": "2025-06-13T10:00:00Z", "attendees": "Cor", "overall_impression": "Second opinion confirms the good feeling.", "experience": "Cor liked the layout a lot. Noticed a small damp patch in the corner of the main bedroom.", "considerations": "Get an inspector to look at the damp before making an offer.", "created_by": 2, "created_at": "2025-06-13T12:00:00Z"}},
  {"model": "journal.visit", "pk": 3, "fields": {"house": 2, "visited_at": "2025-06-05T15:00:00Z", "attendees": "Wes", "overall_impression": "Beautiful but loud at night.", "experience": "The renovation is top notch \u2014 exposed beams, polished concrete floors, a very stylish bathroom. But the street below is packed with tourists and there is a fado bar two doors down. I could hear singing from inside the flat at 11pm.", "considerations": "Probably a great Airbnb but not a peaceful home for us.", "created_by": 3, "created_at": "2025-06-05T19:00:00Z"}},
  {"model": "journal.visit", "pk": 4, "fields": {"house": 4, "visited_at": "2025-05-26T11:00:00Z", "attendees": "Wes, Bru", "overall_impression": "Too small and too dark.", "experience": "The building entrance is dark and the corridor smells of humidity. The studio itself has a single window facing an interior courtyard. Would need a full renovation just to be liveable.", "considerations": "Pass.", "created_by": 1, "created_at": "2025-05-26T14:00:00Z"}},
  {"model": "journal.visit", "pk": 5, "fields": {"house": 5, "visited_at": "2025-06-12T16:00:00Z", "attendees": "Wes, Cor", "overall_impression": "Solid candidate but the kitchen needs replacing.", "experience": "Fifth floor with a view over the basilica. The living room is generous and gets sun all afternoon. Bathroom is dated but functional. Kitchen is original 70s and would need a full renovation, roughly 20-25k.", "considerations": "Factor the kitchen renovation into the offer price.", "created_by": 2, "created_at": "2025-06-12T19:00:00Z"}},
  {"model": "journal.visit", "pk": 6, "fields": {"house": 6, "visited_at": "2025-06-14T10:00:00Z", "attendees": "Wes, Bru, Cor", "overall_impression": "The terrace sells it. Everyone loved it.", "experience": "We visited together on a Saturday morning. The terrace is 40sqm and wraps around two sides of the flat. Views over the city and the river in the distance. Bedrooms are modest but the living area is spectacular.", "considerations": "Price is at the top of our budget. Need to confirm the terrace is legally part of the fraction. Also check building works planned.", "created_by": 3, "created_at": "2025-06-14T13:00:00Z"}},

