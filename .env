# ==============================================================================
# Comeia Environment Configuration
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=production-insecure-change-this-in-live-deployments-$(comeia-secret-key-prod-2026)
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=comeia.settings_production
DJANGO_ALLOWED_HOSTS=comeia.bnvnd.pt,10.10.10.99,localhost,127.0.0.1,0.0.0.0,web
CSRF_TRUSTED_ORIGINS=https://comeia.bnvnd.pt,http://comeia.bnvnd.pt,https://10.10.10.99:8000,http://10.10.10.99:8000,http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL Database Configuration
POSTGRES_DB=comeia
POSTGRES_USER=comeia_user
POSTGRES_PASSWORD=comeia_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://comeia_user:comeia_secure_password@db:5432/comeia

# Server & Container Configuration
PORT=8000
GUNICORN_WORKERS=3

# Security Settings (Set to True if serving behind HTTPS/TLS reverse proxy)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email Configuration
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@comeia.app
